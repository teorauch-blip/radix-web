NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Clave secreta service_role — SOLO servidor (server actions). NO usar NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Origen canónico del sitio, sin barra final.
# Se usa para canonical URLs, sitemap.xml, robots.txt y Open Graph.
# Si no se define, se usa https://www.radixinmobiliaria.com.ar (ver lib/seo/site.ts).
NEXT_PUBLIC_SITE_URL=https://www.radixinmobiliaria.com.ar

# ── Google tag (gtag.js) ──────────────────────────────────────────
# ID de Google Ads. Opcional: si no se define se usa AW-18381666105
# (ver lib/analytics/google.ts). Definirlo solo para pisar el default.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18381666105

# ID de GA4 (G-XXXXXXXXXX). Vacío o sin definir = GA4 desactivado.
# Al definirlo se suma a la MISMA Google tag, sin cargar gtag.js dos veces.
NEXT_PUBLIC_GA4_ID=
